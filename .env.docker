APP_NAME=Saycle
APP_ENV=production
APP_KEY=base64:
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://saycle.my.id

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Required for DatabaseSeeder. Set both values before running `php artisan db:seed`.
ADMIN_EMAIL=admin@saycle.my.id
ADMIN_PASSWORD=Password123!
# Optional officer seed. Set both values, or leave both empty.
OFFICER_EMAIL=officer@saycle.my.id
OFFICER_PASSWORD=Password123!

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=saycle
DB_USERNAME=saycle
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=memcached

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@rpcwb.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=saycle-bucket
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"
